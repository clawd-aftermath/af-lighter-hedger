# Bot-host secrets only. Use a dedicated Aftermath agent, never its owner key.
# AF_AGENT_PRIVATE_KEY uses the Sui suiprivkey encoding.
# LIGHTER_API_PRIVATE_KEY is the registered Lighter API trading key, not an L1 key.
# Paper mode needs neither key. Dry and live require both.
AF_AGENT_PRIVATE_KEY=
LIGHTER_API_PRIVATE_KEY=

# Optional Telegram alerts. Both values must be set to enable delivery.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
